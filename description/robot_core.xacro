<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="inertial_macros.xacro"/>


    <!-- ========================================================= -->
    <!-- ROBOT PARAMETERS                                          -->
    <!-- ========================================================= -->

    <xacro:property name="chassis_length" value="0.50"/>
    <xacro:property name="chassis_width" value="0.40"/>
    <xacro:property name="chassis_height" value="0.15"/>

    <xacro:property name="chassis_mass" value="2.50"/>


    <!-- ========================================================= -->
    <!-- DRIVE WHEEL PARAMETERS                                    -->
    <!-- ========================================================= -->

    <xacro:property name="wheel_radius" value="0.05"/>
    <xacro:property name="wheel_thickness" value="0.03"/>
    <xacro:property name="wheel_mass" value="0.18"/>

    <xacro:property name="wheel_separation" value="0.50"/>

    <xacro:property name="chassis_offset_x"
                    value="${chassis_length / 2.0}"/>

    <xacro:property name="wheel_offset_y"
                    value="${wheel_separation / 2.0}"/>

    <xacro:property name="wheel_offset_z"
                    value="${wheel_radius}"/>


    <!-- ========================================================= -->
    <!-- CHASSIS PARAMETERS                                        -->
    <!-- ========================================================= -->

    <xacro:property name="ground_clearance"
                    value="0.025"/>

    <xacro:property name="chassis_offset_z"
                    value="${ground_clearance - wheel_offset_z}"/>


    <!-- ========================================================= -->
    <!-- CASTER PARAMETERS                                         -->
    <!-- ========================================================= -->

    <xacro:property name="caster_wheel_radius"
                    value="0.010"/>

    <xacro:property name="caster_wheel_thickness"
                    value="0.025"/>

    <xacro:property name="caster_wheel_mass"
                    value="0.05"/>

    <xacro:property name="caster_offset_x"
                    value="0.10"/>

    <xacro:property name="caster_offset_y"
                    value="0.15"/>

    <xacro:property name="caster_offset_z"
                    value="-0.015"/>


    <!-- ========================================================= -->
    <!-- MATERIALS                                                 -->
    <!-- ========================================================= -->

    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>

    <material name="orange">
        <color rgba="1 0.3 0.1 1"/>
    </material>

    <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
    </material>

    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>

    <material name="red">
        <color rgba="1 0 0 1"/>
    </material>


    <!-- ========================================================= -->
    <!-- BASE LINK                                                  -->
    <!-- ========================================================= -->

    <link name="base_link">
    </link>


    <!-- ========================================================= -->
    <!-- BASE FOOTPRINT                                             -->
    <!-- ========================================================= -->

    <joint name="base_footprint_joint" type="fixed">

        <parent link="base_link"/>
        <child link="base_footprint"/>

        <origin
            xyz="0 0 ${-wheel_offset_z}"
            rpy="0 0 0"/>

    </joint>


    <link name="base_footprint">
    </link>


    <!-- ========================================================= -->
    <!-- CHASSIS                                                    -->
    <!-- ========================================================= -->

    <joint name="chassis_joint" type="fixed">

        <parent link="base_link"/>
        <child link="chassis"/>

        <origin
            xyz="${-chassis_offset_x}
                 0
                 ${chassis_offset_z}"
            rpy="0 0 0"/>

    </joint>


    <link name="chassis">

        <visual>

            <origin
                xyz="${chassis_length / 2.0}
                     0
                     ${chassis_height / 2.0}"
                rpy="0 0 0"/>

            <geometry>

                <box
                    size="${chassis_length}
                          ${chassis_width}
                          ${chassis_height}"/>

            </geometry>

            <material name="orange"/>

        </visual>


        <collision>

            <origin
                xyz="${chassis_length / 2.0}
                     0
                     ${chassis_height / 2.0}"
                rpy="0 0 0"/>

            <geometry>

                <box
                    size="${chassis_length}
                          ${chassis_width}
                          ${chassis_height}"/>

            </geometry>

        </collision>


        <xacro:inertial_box
            mass="${chassis_mass}"
            x="${chassis_length}"
            y="${chassis_width}"
            z="${chassis_height}">

            <origin
                xyz="${chassis_length / 2.0}
                     0
                     ${chassis_height / 2.0}"
                rpy="0 0 0"/>

        </xacro:inertial_box>

    </link>


    <gazebo reference="chassis">

        <material>Gazebo/Orange</material>

    </gazebo>


    <!-- ========================================================= -->
    <!-- LEFT DRIVE WHEEL                                          -->
    <!-- ========================================================= -->

    <joint name="left_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="left_wheel"/>

        <origin
            xyz="0 ${wheel_offset_y} 0"
            rpy="-${pi / 2.0} 0 0"/>

        <axis xyz="0 0 1"/>

    </joint>


    <link name="left_wheel">

        <visual>

            <geometry>

                <cylinder
                    radius="${wheel_radius}"
                    length="${wheel_thickness}"/>

            </geometry>

            <material name="blue"/>

        </visual>


        <collision>

            <geometry>

                <sphere
                    radius="${wheel_radius}"/>

            </geometry>

        </collision>


        <xacro:inertial_cylinder
            mass="${wheel_mass}"
            length="${wheel_thickness}"
            radius="${wheel_radius}">

            <origin
                xyz="0 0 0"
                rpy="0 0 0"/>

        </xacro:inertial_cylinder>

    </link>


    <gazebo reference="left_wheel">

        <material>Gazebo/Blue</material>

        <!-- <mu1 value="1.0"/>
        <mu2 value="1.0"/> -->
        <mu1 value="0.7"/>
        <mu2 value="0.7"/>

    </gazebo>


    <!-- ========================================================= -->
    <!-- RIGHT DRIVE WHEEL                                         -->
    <!-- ========================================================= -->

    <joint name="right_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="right_wheel"/>

        <origin
            xyz="0 ${-wheel_offset_y} 0"
            rpy="${pi / 2.0} 0 0"/>

        <axis xyz="0 0 -1"/>

    </joint>


    <link name="right_wheel">

        <visual>

            <geometry>

                <cylinder
                    radius="${wheel_radius}"
                    length="${wheel_thickness}"/>

            </geometry>

            <material name="blue"/>

        </visual>


        <collision>

            <geometry>

                <sphere
                    radius="${wheel_radius}"/>

            </geometry>

        </collision>


        <xacro:inertial_cylinder
            mass="${wheel_mass}"
            length="${wheel_thickness}"
            radius="${wheel_radius}">

            <origin
                xyz="0 0 0"
                rpy="0 0 0"/>

        </xacro:inertial_cylinder>

    </link>


    <gazebo reference="right_wheel">

        <material>Gazebo/Blue</material>

        <mu1 value="1.0"/>
        <mu2 value="1.0"/>

    </gazebo>


    <!-- ========================================================= -->
    <!-- CASTER WHEEL MACRO                                        -->
    <!-- ========================================================= -->

    <xacro:macro name="caster_wheel" params="name x y">

        <joint name="${name}_joint" type="fixed">

            <parent link="chassis"/>
            <child link="${name}"/>

            <origin
                xyz="${x}
                     ${y}
                     ${caster_offset_z}"
                rpy="0 0 0"/>

        </joint>


        <link name="${name}">

            <visual>

                <origin
                    xyz="0 0 0"
                    rpy="${pi / 2.0} 0 0"/>

                <geometry>

                    <cylinder
                        radius="${caster_wheel_radius}"
                        length="${caster_wheel_thickness}"/>

                </geometry>

                <material name="white"/>

            </visual>


            <collision>

                <geometry>

                    <sphere
                        radius="${caster_wheel_radius}"/>

                </geometry>

            </collision>


            <xacro:inertial_sphere
                mass="${caster_wheel_mass}"
                radius="${caster_wheel_radius}">

                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/>

            </xacro:inertial_sphere>

        </link>


        <gazebo reference="${name}">

            <material>Gazebo/White</material>

            <mu1 value="0.001"/>
            <mu2 value="0.001"/>

        </gazebo>

    </xacro:macro>


    <!-- ========================================================= -->
    <!-- FOUR CASTER WHEELS                                        -->
    <!-- ========================================================= -->

    <xacro:caster_wheel
        name="rear_left_caster"
        x="${caster_offset_x}"
        y="${caster_offset_y}"/>

    <xacro:caster_wheel
        name="rear_right_caster"
        x="${caster_offset_x}"
        y="${-caster_offset_y}"/>

    <xacro:caster_wheel
        name="front_left_caster"
        x="${chassis_length - caster_offset_x}"
        y="${caster_offset_y}"/>

    <xacro:caster_wheel
        name="front_right_caster"
        x="${chassis_length - caster_offset_x}"
        y="${-caster_offset_y}"/>


</robot>