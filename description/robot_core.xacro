<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="inertial_macros.xacro" />

    <material name="white">
        <color rgba="1 1 1 1" />
    </material>

    <material name="orange">
        <color rgba="1 0.3 0.1 1" />
    </material>

    <material name="blue">
        <color rgba="0.2 0.2 1 1" />
    </material>

    <material name="black">
        <color rgba="0 0 0 1" />
    </material>

    <material name="red">
        <color rgba="1 0 0 1" />
    </material>

    <!-- BASE LINK -->

    <link name="base_link">

    </link>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link" />
        <child link="chassis" />
        <origin xyz="-0.25 0 -0.0175" />
    </joint>

    <!-- CHASSIS LINK -->

    <link name="chassis">
        <visual>
            <origin xyz="0.25 0 0.075" />
            <geometry>
                <box size="0.5 0.4 0.15" />
            </geometry>
            <material name="white" />
        </visual>
        <collision>
            <origin xyz="0.25 0 0.075" />
            <geometry>
                <box size="0.5 0.4 0.15" />
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.5" x="0.5" y="0.4" z="0.15">
            <origin xyz="0.25 0.2 0.075" rpy="0 0 0" />
        </xacro:inertial_box>
    </link>

    <gazebo reference="chassis">
        <material>
            Gazebo/White
        </material>
    </gazebo>

    <!-- LEFT WHEEL LINK -->
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel" />
        <origin xyz="0 0.22 0" rpy="-${pi/2} 0 0" />
        <axis xyz="0 0 1" />
    </joint>

    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.045" length="0.015" />
            </geometry>
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.045" length="0.015" />
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.015" radius="0.045">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="left_wheel">
        <material>
            Gazebo/Blue
        </material>
    </gazebo>

    <!-- RIGHT WHEEL LINK -->
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel" />
        <origin xyz="0 -0.22 0" rpy="${pi/2} 0 0" />
        <axis xyz="0 0 -1" />
    </joint>

    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.045" length="0.015" />
            </geometry>
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.045" length="0.015" />
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.015" radius="0.045">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="right_wheel">
        <material>
            Gazebo/Blue
        </material>
    </gazebo>

    <!-- CASTER WHEEL -->

    <joint name="caster_wheel_fontleft_joint" type="fixed">
        <parent link="chassis" />
        <child link="caster_wheel_fontleft" />
        <origin xyz="0.4 0.15 0" />
    </joint>

    <link name="caster_wheel_fontleft">
        <visual>
            <geometry>
                <sphere radius="0.03" />
            </geometry>
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.03" />
            </geometry>
        </collision>
        <xacro:inertial_sphere mass="0.03" radius="0.03">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:inertial_sphere>
    </link>

    <gazebo reference="caster_wheel_fontleft">
        <material>
            Gazebo/Black
        </material>
        <!-- Friction -->
        <mu1 value="0.001" />
        <mu2 value="0.001" />
    </gazebo>

</robot>